+int
+ksetpriority(int pid, int priority)
+{
+  struct proc *p;
+
+  if (pid <= 0 || priority < 0 || priority > 3)
+    return -1;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->pid == pid && p->state != UNUSED) {
+      p->priority = priority;
+      release(&p->lock);
+      return 0;
+    }
+    release(&p->lock);
+  }
+  return -1;
+}
+
+void
+accounttick(void)
+{
+  struct proc *p = myproc();
+
+  if (p == 0)
+    return;
+  acquire(&p->lock);
+  if (p->state == RUNNING)
+    p->runtime_ticks++;
+  release(&p->lock);
+}
+
+int
+kgetpstats(int pid, uint64 address)
+{
+  struct proc *caller = myproc();
+  struct proc *p;
+  struct pstat stats;
+
+  if (pid == 0)
+    pid = caller->pid;
+  for (p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if (p->pid == pid && p->state != UNUSED) {
+      stats.pid = p->pid;
+      stats.priority = p->priority;
+      stats.dispatches = p->dispatches;
+      stats.runtime_ticks = p->runtime_ticks;
+      release(&p->lock);
+      return copyout(caller->pagetable, caller->sz, address,
+                     (char *)&stats, sizeof(stats));
     }
+    release(&p->lock);
   }
+  return -1;
 }
 
